{
  "name": "web-perf-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env --require dd-trace/init dist/main.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migration-file-language sql",
    "seed:dev": "node --env-file-if-exists=.env scripts/seed-dev.cjs",
    "lint": "eslint src",
    "format:check": "prettier --check src scripts/seed-dev.cjs package.json tsconfig.json eslint.config.mjs .prettierrc.json",
    "test": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "dd-trace": "^6.24.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
