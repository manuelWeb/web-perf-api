# Valeurs locales uniquement. Le mot de passe ci-dessous est public.
PGHOST=db
PGPORT=5432
PGUSER=web_perf_api
PGDATABASE=web_perf_api
PGPASSWORD=local-dev-only

# APM local. Activer uniquement si un Datadog Agent reçoit les traces.
DD_TRACE_ENABLED=false
DD_SERVICE=web-perf-api
DD_ENV=development
DD_VERSION=0.1.0
DD_TRACE_AGENT_URL=http://host.docker.internal:8126
APM_DEMO_ENABLED=true
CORS_ORIGINS=http://localhost:3000
